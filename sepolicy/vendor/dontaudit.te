dontaudit vendor_init build_prop:property_service set;
dontaudit vendor_init userdebug_or_eng_prop:property_service set;

dontaudit hal_nfc_default hal_secure_element_hwservice:hwservice_manager find;

dontaudit cacaoserver shell_data_file:dir search;

dontaudit {
  adpl
  atfwd
  cnd
  hal_bluetooth_qti
  hal_dpmQmiMgr
  hal_gnss_qti
  hal_imsrtp
  hal_rcsservice
  hal_sensors_default
  ims
  location
  netmgrd
  qti
  qtidataservices_app
  rild
  sensors
  thermal-engine
  time_daemon
  vendor_pd_mapper
  vendor_per_mgr
  wcnss_service
} oneplus_prop:file read;

dontaudit {
  adpl
  cnd
  hal_dpmQmiMgr
  hal_gnss_qti
  hal_imsrtp
  hal_rcsservice
  ims
  location
  netmgrd
  port-bridge
  qti
  qtidataservices_app
  rild
  thermal-engine
  time_daemon
  wcnss_service
  } vendor_target_id_prop:file read;
